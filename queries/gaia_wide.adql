-- WP1 Gaia DR3 wide candidate query for runaway/traceback support
-- Exact Galactic-coordinate filtering is performed locally with Astropy.
-- This ICRS cone safely encloses l=[72,88] deg, b=[-5,8] deg.
SELECT
    source_id,
    ra, dec,
    ra_error, dec_error,
    parallax, parallax_error,
    pmra, pmra_error,
    pmdec, pmdec_error,
    ra_dec_corr,
    ra_parallax_corr,
    ra_pmra_corr,
    ra_pmdec_corr,
    dec_parallax_corr,
    dec_pmra_corr,
    dec_pmdec_corr,
    parallax_pmra_corr,
    parallax_pmdec_corr,
    pmra_pmdec_corr,
    phot_g_mean_mag,
    phot_g_mean_flux_error,
    phot_bp_mean_mag,
    phot_bp_mean_flux_error,
    phot_rp_mean_mag,
    phot_rp_mean_flux_error,
    phot_bp_rp_excess_factor,
    ruwe,
    visibility_periods_used,
    astrometric_params_solved,
    astrometric_excess_noise,
    astrometric_excess_noise_sig,
    astrometric_n_good_obs_al,
    astrometric_n_bad_obs_al,
    radial_velocity,
    radial_velocity_error,
    ref_epoch,
    nu_eff_used_in_astrometry,
    pseudocolour
FROM gaiadr3.gaia_source
WHERE 1 = CONTAINS(
    POINT('ICRS', ra, dec),
    CIRCLE('ICRS', 308.3, 41.2, 12.0)
)
AND parallax BETWEEN 0.35 AND 1.10
AND phot_g_mean_mag < 19
